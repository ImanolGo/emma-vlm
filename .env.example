# OpenRouter API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: override the default model (config/config.yaml -> model.name)
# EMMA_MODEL=google/gemini-3.8-flash

# Path to the nuImages dataset (folder containing samples/, sweeps/, v1.0-mini/)
NUIMAGES_DATAROOT=/path/to/nuimages
